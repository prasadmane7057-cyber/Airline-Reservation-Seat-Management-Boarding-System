PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Optional MySQL connection. When unavailable, accounts use the private CSV store.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=airline_reservation
JWT_EXPIRES_IN=7d

# Local frontend origin; Render sets the public site origin in render.yaml.
FRONTEND_ORIGIN=http://localhost:5173

# Use a persistent, private disk path when deploying without MySQL.
# CSV_USERS_PATH=
