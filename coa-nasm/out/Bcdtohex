; =====================================================================
; BCDToHex.asm
; COA Review 4 - Convert a 64-bit packed BCD number to Hexadecimal
; Owner: Varad
; CO3 (2310221L.CO.3): Illustrate processor level details about
;                      arithmetic operations using computer arithmetic algorithms.
;
; Platform : NASM, 64-bit Linux (same setup as FareCalc.asm)
; Build    : nasm -f elf64 BCDToHex.asm -o BCDToHex.o
;            ld BCDToHex.o -o BCDToHex
; Run      : ./BCDToHex
;
; WHAT IT DOES
;   1. Reads a decimal number (up to 16 digits) typed by the user.
;      Each digit is stored in 4 bits  ->  "packed BCD" (16 digits = 64 bits).
;        e.g. 1234  ->  0x0000000000001234   (NOT 0x4D2)
;   2. Converts that BCD value to a true binary / hex value.
;        e.g. BCD 0x1234  ->  Hex 0x00000000000004D2
;      Algorithm (Horner's rule, most-significant digit first):
;           result = 0
;           for each BCD digit d (left to right):  result = result*10 + d
;   3. ROUND TRIP CHECK: converts the Hex back to BCD (repeated division
;      by 10) and then back to Hex again, and confirms the number is unchanged.
;
; ROUTINES (callable - you can reuse them from FareCalc.asm)
;   bcd_to_hex : in  RDI = packed BCD
;                out RAX = binary value,   CF = 1 if any nibble was > 9
;   hex_to_bcd : in  RAX = binary value (must be <= 9999999999999999)
;                out RAX = packed BCD
;   print_hex64: in  RAX = value, prints "0x" + 16 hex digits
; =====================================================================

section .data
    prompt      db  "Enter BCD number (1 to 16 decimal digits, e.g. 1234): "
    prompt_len  equ $ - prompt

    msg_bcd     db  10, "  Packed BCD (64-bit)  : "
    msg_bcd_len equ $ - msg_bcd

    msg_hex     db  "  Converted to Hex     : "
    msg_hex_len equ $ - msg_hex

    msg_back    db  "  Hex -> BCD (check)   : "
    msg_back_len equ $ - msg_back

    msg_hex2    db  "  BCD -> Hex (again)   : "
    msg_hex2_len equ $ - msg_hex2

    msg_pass    db  "  Round trip           : PASS - Hex -> BCD -> Hex gives the original number", 10
    msg_pass_len equ $ - msg_pass

    msg_fail    db  "  Round trip           : FAIL - value changed!", 10
    msg_fail_len equ $ - msg_fail

    err_empty   db  "  Error: nothing entered.", 10
    err_empty_len equ $ - err_empty

    err_char    db  "  Error: only digits 0-9 are allowed.", 10
    err_char_len equ $ - err_char

    err_long    db  "  Error: a 64-bit BCD number holds at most 16 digits.", 10
    err_long_len equ $ - err_long

    again       db  10, "Convert another? (y/n): "
    again_len   equ $ - again

    nl          db  10
    hexdigits   db  "0123456789ABCDEF"

section .bss
    inbuf   resb 64
    outbuf  resb 20

section .text
    global _start

; ---------------------------------------------------------------------
; Macro: write a message to stdout   (PRINT label, length)
; ---------------------------------------------------------------------
%macro PRINT 2
    mov     rax, 1              ; sys_write
    mov     rdi, 1              ; stdout
    lea     rsi, [%1]
    mov     rdx, %2
    syscall
%endmacro

_start:
main_loop:
    PRINT prompt, prompt_len

    ; ---- read a line from the keyboard ----
    mov     rax, 0              ; sys_read
    mov     rdi, 0              ; stdin
    lea     rsi, [inbuf]
    mov     rdx, 63
    syscall
    test    rax, rax
    jle     exit_program        ; EOF / error -> quit
    mov     rcx, rax            ; number of bytes read

    ; ---- parse the digits into packed BCD (result in RBX) ----
    lea     rsi, [inbuf]
    xor     rbx, rbx            ; packed BCD accumulator
    xor     r8, r8              ; digit counter
.parse:
    test    rcx, rcx
    jz      .parse_done
    movzx   rax, byte [rsi]
    inc     rsi
    dec     rcx
    cmp     al, 10              ; newline ends the number
    je      .parse_done
    cmp     al, 13              ; carriage return (Windows line ending)
    je      .parse_done
    cmp     al, '0'
    jb      .bad_char
    cmp     al, '9'
    ja      .bad_char
    inc     r8
    cmp     r8, 16
    ja      .too_long
    sub     al, '0'
    shl     rbx, 4              ; make room for one more nibble
    or      rbx, rax            ; store the digit in the low nibble
    jmp     .parse
.parse_done:
    test    r8, r8
    jz      .empty
    jmp     .convert

.empty:
    PRINT err_empty, err_empty_len
    jmp     ask_again
.bad_char:
    PRINT err_char, err_char_len
    jmp     ask_again
.too_long:
    PRINT err_long, err_long_len
    jmp     ask_again

    ; ---- convert and display ----
.convert:
    mov     r12, rbx            ; r12 = original packed BCD (kept safe)

    PRINT msg_bcd, msg_bcd_len
    mov     rax, r12
    call    print_hex64

    mov     rdi, r12
    call    bcd_to_hex          ; RAX = binary value
    mov     r13, rax            ; r13 = hex result

    PRINT msg_hex, msg_hex_len
    mov     rax, r13
    call    print_hex64

    ; ---- round trip: Hex -> BCD -> Hex ----
    mov     rax, r13
    call    hex_to_bcd          ; RAX = packed BCD again
    mov     r14, rax
    PRINT msg_back, msg_back_len
    mov     rax, r14
    call    print_hex64

    mov     rdi, r14
    call    bcd_to_hex          ; RAX = binary again
    mov     r15, rax
    PRINT msg_hex2, msg_hex2_len
    mov     rax, r15
    call    print_hex64

    cmp     r15, r13            ; same hex as before?
    jne     .rt_fail
    cmp     r14, r12            ; same BCD as typed?
    jne     .rt_fail
    PRINT msg_pass, msg_pass_len
    jmp     ask_again
.rt_fail:
    PRINT msg_fail, msg_fail_len

ask_again:
    PRINT again, again_len
    mov     rax, 0
    mov     rdi, 0
    lea     rsi, [inbuf]
    mov     rdx, 63
    syscall
    test    rax, rax
    jle     exit_program
    movzx   rax, byte [inbuf]
    cmp     al, 'y'
    je      main_loop
    cmp     al, 'Y'
    je      main_loop

exit_program:
    mov     rax, 60             ; sys_exit
    xor     rdi, rdi
    syscall

; =====================================================================
; bcd_to_hex
;   Input : RDI = packed BCD (16 nibbles)
;   Output: RAX = binary value
;           CF  = 1 if a nibble greater than 9 was found (invalid BCD)
;   Uses  : RCX, RDX, RBX (RBX is saved/restored)
; =====================================================================
bcd_to_hex:
    push    rbx
    xor     rax, rax            ; result = 0
    mov     rdx, rdi            ; working copy
    mov     rcx, 16             ; 16 nibbles
.next:
    rol     rdx, 4              ; bring the next (leftmost) nibble to bits 3..0
    mov     rbx, rdx
    and     rbx, 0Fh            ; rbx = current digit
    cmp     rbx, 9
    ja      .invalid
    imul    rax, rax, 10        ; result = result * 10
    add     rax, rbx            ; result = result + digit
    dec     rcx
    jnz     .next
    pop     rbx
    clc                         ; CF = 0 -> valid
    ret
.invalid:
    pop     rbx
    stc                         ; CF = 1 -> invalid BCD digit
    ret

; =====================================================================
; hex_to_bcd   (repeated division by 10)
;   Input : RAX = binary value  (<= 9999999999999999)
;   Output: RAX = packed BCD
;   Uses  : RCX, RDX, R8, R9, R10
; =====================================================================
hex_to_bcd:
    xor     r9, r9              ; packed BCD result
    xor     r8, r8              ; bit position for the next digit
    mov     r10, 10
.divloop:
    xor     rdx, rdx
    div     r10                 ; RAX = RAX / 10, RDX = remainder (a digit)
    mov     rcx, r8
    shl     rdx, cl             ; move the digit to its nibble
    or      r9, rdx
    add     r8, 4
    test    rax, rax
    jnz     .divloop
    mov     rax, r9
    ret

; =====================================================================
; print_hex64 : prints RAX as "0x" followed by 16 hex digits and a newline
; =====================================================================
print_hex64:
    push    rbx
    lea     rdi, [outbuf]
    mov     byte [rdi], '0'
    mov     byte [rdi+1], 'x'
    add     rdi, 2
    mov     rcx, 16
.hexloop:
    rol     rax, 4
    mov     rdx, rax
    and     edx, 0Fh
    lea     rbx, [hexdigits]
    mov     dl, [rbx + rdx]
    mov     [rdi], dl
    inc     rdi
    dec     rcx
    jnz     .hexloop
    mov     byte [rdi], 10      ; newline

    mov     rax, 1
    mov     rdi, 1
    lea     rsi, [outbuf]
    mov     rdx, 19             ; "0x" + 16 digits + newline
    syscall
    pop     rbx
    ret
