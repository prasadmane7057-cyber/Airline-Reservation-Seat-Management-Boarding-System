// StaffMember.java
// UPDATED: Person is now abstract, so StaffMember must implement getRole().
// This is the only change needed here - everything else stays the same.

public class StaffMember extends Person {
    private String employeeId;
    private String designation;

    public StaffMember(String name, int age, String gender, String contactNumber,
                        String employeeId, String designation) {
        super(name, age, gender, contactNumber);
        this.employeeId = employeeId;
        this.designation = designation;
    }

    public String getEmployeeId() {
        return employeeId;
    }

    public String getDesignation() {
        return designation;
    }

    // REQUIRED now that Person is abstract - without this, StaffMember
    // would fail to compile.
    @Override
    public String getRole() {
        return "Staff (" + designation + ")";
    }

    // Adds the staff-only fields on top of Person's shared displayDetails()
    @Override
    public void displayDetails() {
        super.displayDetails();
        System.out.println("Employee ID  : " + employeeId);
    }
}
