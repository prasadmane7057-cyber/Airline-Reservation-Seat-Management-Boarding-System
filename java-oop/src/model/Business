// Business.java
public class Business implements BookingClass {
    @Override
    public double calculateFare(double baseFare) {
        return baseFare * 1.75; // 75% markup over economy
    }

    @Override
    public int getBaggageAllowanceKg() {
        return 30;
    }

    @Override
    public String getClassName() {
        return "Business";
    }
}
