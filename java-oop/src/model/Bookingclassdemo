// BookingClassDemo.java
// NOT a required deliverable - just a quick test harness to check
// the abstract Person + BookingClass interface actually work.

public class BookingClassDemo {
    public static void main(String[] args) {
        System.out.println("=== Testing abstract Person via StaffMember ===");
        StaffMember staff = new StaffMember("Anita Rao", 29, "Female", "9876543210",
                                             "EMP1001", "Cabin Crew");
        staff.displayDetails();
        // Person person = new Person(...);  <-- this line would NOT compile,
        // which is exactly the point of making Person abstract.

        System.out.println("\n=== Testing BookingClass interface (polymorphism) ===");
        double baseFare = 5000.0;
        BookingClass[] classes = { new Economy(), new Business(), new FirstClass() };

        for (BookingClass bc : classes) {
            System.out.println(bc.getClassName() +
                    " -> Fare: Rs." + bc.calculateFare(baseFare) +
                    " | Baggage: " + bc.getBaggageAllowanceKg() + "kg");
        }
    }
}
