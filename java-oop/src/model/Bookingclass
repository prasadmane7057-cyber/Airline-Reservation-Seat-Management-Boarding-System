// BookingClass.java
// PSOOP - Interface for the different seat/booking classes.
// Owner: Varad
//
// Any class that implements this (Economy, Business, FirstClass) MUST
// provide its own version of every method below. This is what lets the
// rest of the code treat all three the same way (polymorphism) while
// each one calculates fare / baggage differently underneath.

public interface BookingClass {

    // Takes the flight's base fare and returns the actual price for this class
    double calculateFare(double baseFare);

    // How many kg of check-in baggage this class allows
    int getBaggageAllowanceKg();

    // Display name for this class, e.g. "Economy", "Business", "First Class"
    String getClassName();
}
