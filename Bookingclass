package airline.model;

// BookingClass.java
// PSOOP - interface for the seat / booking classes.
// Implemented by Economy, Business and FirstClass.
// Owner: Varad

public interface BookingClass {

    // Takes the flight's base fare and returns the price for this class
    double calculateFare(double baseFare);

    // Kilograms of check-in baggage this class allows
    int getBaggageAllowanceKg();

    // Display name: "Economy", "Business" or "First Class"
    String getClassName();
}
