#include <iostream>
#include <string>
using namespace std;

// ---------- Node definition ----------
struct BookingNode {
    string pnr;
    string passengerName;
    string flightNumber;
    string bookingDate;
    BookingNode* next;

    BookingNode(string p, string name, string flight, string date) {
        pnr = p;
        passengerName = name;
        flightNumber = flight;
        bookingDate = date;
        next = nullptr;
    }
};

// ---------- Linked list class ----------
class BookingHistoryList {
private:
    BookingNode* head;

public:
    BookingHistoryList() {
        head = nullptr;
    }

    // Insert a new booking at the end of the list
    void insertBooking(string pnr, string passengerName, string flightNumber, string bookingDate) {
        BookingNode* newNode = new BookingNode(pnr, passengerName, flightNumber, bookingDate);

        if (head == nullptr) {
            head = newNode;
            cout << "Booking inserted -> PNR: " << pnr << ", Passenger: " << passengerName << endl;
            return;
        }

        BookingNode* temp = head;
        while (temp->next != nullptr) {
            temp = temp->next;
        }
        temp->next = newNode;
        cout << "Booking inserted -> PNR: " << pnr << ", Passenger: " << passengerName << endl;
    }

    // Search a booking by PNR. Returns true and prints details if found.
    bool searchBooking(string pnr) {
        BookingNode* temp = head;
        while (temp != nullptr) {
            if (temp->pnr == pnr) {
                cout << "\nBooking Found:" << endl;
                cout << "  PNR            : " << temp->pnr << endl;
                cout << "  Passenger Name : " << temp->passengerName << endl;
                cout << "  Flight Number  : " << temp->flightNumber << endl;
                cout << "  Booking Date   : " << temp->bookingDate << endl;
                return true;
            }
            temp = temp->next;
        }
        cout << "\nNo booking found with PNR: " << pnr << endl;
        return false;
    }

    // ---------- NEW: deleteBooking() ----------
    // Finds the node with the matching PNR, unlinks it from the chain,
    // then frees (deletes) its memory. Returns true if something was deleted.
    bool deleteBooking(string pnr) {
        if (head == nullptr) {
            cout << "\nCannot delete - booking history is empty." << endl;
            return false;
        }

        // Case 1: the node to delete is the head itself
        if (head->pnr == pnr) {
            BookingNode* toDelete = head;
            head = head->next;      // unlink: move head forward
            delete toDelete;        // release memory
            cout << "\nDeleted booking with PNR: " << pnr << endl;
            return true;
        }

        // Case 2: the node to delete is somewhere after the head
        BookingNode* current = head;
        while (current->next != nullptr) {
            if (current->next->pnr == pnr) {
                BookingNode* toDelete = current->next;
                current->next = toDelete->next;  // unlink: skip over toDelete
                delete toDelete;                 // release memory
                cout << "\nDeleted booking with PNR: " << pnr << endl;
                return true;
            }
            current = current->next;
        }

        // Case 3: PNR not found anywhere in the list
        cout << "\nCannot delete - no booking found with PNR: " << pnr << endl;
        return false;
    }

    // Show every booking currently stored (useful for testing/demo)
    void displayAll() {
        if (head == nullptr) {
            cout << "\nNo bookings in history yet." << endl;
            return;
        }

        cout << "\n--- Booking History ---" << endl;
        BookingNode* temp = head;
        int count = 1;
        while (temp != nullptr) {
            cout << count << ". PNR: " << temp->pnr
                 << " | Passenger: " << temp->passengerName
                 << " | Flight: " << temp->flightNumber
                 << " | Date: " << temp->bookingDate << endl;
            temp = temp->next;
            count++;
        }
    }

    // Frees all remaining nodes so the program doesn't leak memory
    ~BookingHistoryList() {
        BookingNode* temp = head;
        while (temp != nullptr) {
            BookingNode* toDelete = temp;
            temp = temp->next;
            delete toDelete;
        }
    }
};

// ---------- Demo / test driver ----------
int main() {
    BookingHistoryList history;

    // Insert sample bookings
    history.insertBooking("PNR1001", "Rahul Sharma", "AI-202", "2026-09-10");
    history.insertBooking("PNR1002", "Neha Verma", "AI-303", "2026-09-11");
    history.insertBooking("PNR1003", "Rahul Sharma", "AI-404", "2026-09-15");

    history.displayAll();

    // Search tests
    history.searchBooking("PNR1002");   // found
    history.searchBooking("PNR9999");   // not found

    // ---- Delete tests ----
    cout << "\n===== Testing deleteBooking() =====" << endl;
    history.deleteBooking("PNR1002");   // delete a middle/only-matching node
    history.displayAll();               // PNR1002 should be gone

    history.deleteBooking("PNR1001");   // delete the head node
    history.displayAll();               // only PNR1003 should remain

    history.deleteBooking("PNR9999");   // try deleting something that doesn't exist
    history.deleteBooking("PNR1003");   // delete the last remaining node
    history.displayAll();               // should say "No bookings in history yet."

    return 0;
}
